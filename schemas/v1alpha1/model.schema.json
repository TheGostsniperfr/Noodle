{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheGostsniperfr/Noodle/schemas/v1alpha1/model.schema.json",
  "title": "noodle Model",
  "description": "What exists: elements (zones included), connections, references and annotations. No coordinates, no step numbers (ADR-0002, ADR-0007).",
  "type": "object",
  "required": ["apiVersion", "kind"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "noodle/v1alpha1"},
    "kind": {"const": "Model"},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "offerings": {"type": "array", "items": {"$ref": "#/$defs/offering"}, "description": "What the platform offers its users (ADR-0012)."}
  },
  "$defs": {
    "offering": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "summary": {"type": "string"},
        "provides": {"type": "array", "items": {"type": "string"}},
        "request": {"type": "string", "description": "How a user gets it, e.g. a values key."},
        "backed_by": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "Element ids."},
        "owner": {"type": "string"},
        "status": {"enum": ["planned", "deprecated"]},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "element": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["frontend", "backend", "database", "cloud", "security", "bus", "external", "tool", "region", "group"], "description": "tool: built or run with, receives no traffic (ADR-0011)."},
        "parent": {"$ref": "#/$defs/id", "description": "A zone (kind region or group)."},
        "title": {"type": "string"},
        "tech": {"type": "string"},
        "desc": {"type": "string"},
        "icon": {"type": "string"},
        "shape": {"enum": ["box", "cylinder", "actor"]},
        "color": {"type": "string", "description": "Zones only."},
        "sub": {"type": "string", "description": "Zones only."},
        "ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["planned", "deprecated"], "description": "ADR-0008. Absent means live."},
        "target": {"type": "string", "minLength": 1, "description": "ADR-0013. When a planned element is expected, e.g. 'SP1'."},
        "multiplicity": {"type": "string", "minLength": 1, "description": "ADR-0008, e.g. 'one per team'."}
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "protocol", "port"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "protocol": {"enum": ["TCP", "UDP", "SCTP"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "connection": {
      "type": "object",
      "required": ["id", "from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id", "description": "The side that opens the connection (ADR-0003)."},
        "to": {"$ref": "#/$defs/id", "description": "The side that listens."},
        "port": {"type": "string", "description": "Name of a port of the target."},
        "protocol": {"type": "string"},
        "verb": {"type": "string"},
        "kind": {"enum": ["flow", "auth", "tunnel", "async"]},
        "denied": {"type": "boolean", "description": "Intent: this connection must not happen (ADR-0010)."},
        "enforced_by": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "description": "Elements that enforce the refusal (NetworkPolicy, security group). Absent means intent only."}
      },
      "dependentSchemas": {"enforced_by": {"required": ["denied"], "properties": {"denied": {"const": true}}}}
    },
    "reference": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "description": "parentRef, targetRef, envFrom, …"}
      }
    },
    "annotation": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["low", "medium", "high"]},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "Elements get a badge; connections and references get a warning after their label."}
      }
    }
  }
}
