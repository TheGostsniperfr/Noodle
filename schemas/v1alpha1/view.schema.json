{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheGostsniperfr/Noodle/schemas/v1alpha1/view.schema.json",
  "title": "noodle View",
  "description": "What is shown: a selection of the model with steps, labels, cards and notes. The view id is the file stem (ADR-0007, ADR-0009).",
  "type": "object",
  "required": ["apiVersion", "kind", "type"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "noodle/v1alpha1"},
    "kind": {"const": "View"},
    "type": {"enum": ["topology", "sequence"]},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "meta": {"type": "array", "items": {"type": "string"}},
    "include": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(/\\*\\*)?$"}, "description": "Element ids, or zone/** for a subtree. Absent means everything."},
    "steps": {"type": "array", "items": {"type": "string"}, "description": "Connection ids of the request path, numbered [1]..[n] (ADR-0004)."},
    "background": {"type": "array", "items": {"type": "string"}, "description": "Connection ids of background work, lettered [A].."},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Label overrides by connection or reference id."},
    "participants": {"type": "array", "items": {"type": "string"}, "description": "Sequence views only: column order."},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}}
  },
  "if": {"properties": {"type": {"const": "topology"}}},
  "then": {"not": {"required": ["participants"]}},
  "$defs": {
    "card": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "color": {"type": "string"},
        "legend": {"type": "boolean"},
        "lines": {"type": "array", "items": {"type": "string"}}
      }
    },
    "note": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"}
      }
    }
  }
}
