{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheGostsniperfr/Noodle/schemas/v1alpha1/view.schema.json",
  "title": "noodle View",
  "description": "What is shown: a selection of the model with steps, labels, cards and notes. The view id is the file stem (ADR-0007, ADR-0009).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "noodle/v1alpha1"
    },
    "kind": {
      "const": "View"
    },
    "type": {
      "enum": [
        "topology",
        "sequence",
        "landscape",
        "catalog",
        "matrix"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "meta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(/\\*\\*)?$"
      },
      "description": "Element ids, or zone/** for a subtree; offering ids in catalog views. Absent means everything."
    },
    "steps": {
      "type": "array",
      "description": "Topology: connection ids of the request path, numbered [1]..[n] (ADR-0004). Sequence: messages, replies and notes (ADR-0011)."
    },
    "background": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Connection ids of background work, lettered [A].."
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Label overrides by connection or reference id; by element id in landscape views."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sequence views only: column order."
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/band"
      },
      "description": "Landscape views only: rows of sections (ADR-0012)."
    },
    "side": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "description": "Landscape views only: the right-hand column."
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Landscape views only: canvas width the grid wraps to."
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Catalog views only: cards per row (ADR-0013)."
    },
    "identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "description": "Matrix views only: row groups of identity ids (ADR-0019)."
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "description": "Matrix views only: column groups of resource ids."
    },
    "state": {
      "enum": [
        "current",
        "target",
        "diff"
      ],
      "description": "Matrix views: which grants count, default current (ADR-0019). Topology views: diff only, draws planned as added and deprecated as removed over the dimmed rest (ADR-0021)."
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "legend": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "sequenceStep": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "from",
            "to",
            "over"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "over": {
              "type": "string",
              "description": "A model connection joining from and to, in either direction."
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reply"
          ],
          "additionalProperties": false,
          "properties": {
            "reply": {
              "type": "string",
              "description": "Id of an earlier message; travels back over its connection."
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string",
              "description": "The participant acting on its own."
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "band": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "title": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "flow": {
          "type": "boolean",
          "description": "Arrows between consecutive sections."
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "sub": {
          "type": "string",
          "description": "Matrix views: a line under the group title."
        },
        "color": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Element ids."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "topology"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "participants"
          ]
        },
        "properties": {
          "steps": {
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "$ref": "#/$defs/sequenceStep"
            }
          },
          "background": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
