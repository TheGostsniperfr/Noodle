        </mxCell>
        <mxCell id="n-spa" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The SPA&amp;#39;s fetch() runs in the &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;browser&lt;/font&gt;&lt;/b&gt;: /api goes back through eg as &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt;, never pod to pod.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
