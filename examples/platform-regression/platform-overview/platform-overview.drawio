        </mxCell>
        <mxCell id="n-apply" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Argo CD, VSO and CNPG act through the &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;kube-apiserver&lt;/font&gt;&lt;/b&gt;: they write objects, never talk to pods.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
