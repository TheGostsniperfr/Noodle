        <mxCell id="n-302" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Without a session, eg replies &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;302&lt;/font&gt;&lt;/b&gt; to GitLab OIDC. Login is a separate sequence diagram.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
