        <mxCell id="n-apps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Same layout in every app repo: generated from &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;app-templates&lt;/font&gt;&lt;/b&gt;, CI from &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;ci-cd-templates&lt;/font&gt;&lt;/b&gt;, images FROM &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;base-images&lt;/font&gt;&lt;/b&gt;.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="860" y="355" width="760" height="70" as="geometry" />
